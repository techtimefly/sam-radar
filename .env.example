# Required
SAM_GOV_API_KEY=

# Public URL used in Slack/Telegram/report links. For homelab nginx, use https://sam-radar.example.test
APP_BASE_URL=http://localhost:8066

# Listen address for the app container/process
SAM_RADAR_HOST=0.0.0.0
SAM_RADAR_PORT=8066
TIMEZONE=America/Denver
# Required for browser status/notes updates. Generate with: sam-radar generate-token
APP_WRITE_TOKEN=
BUSINESS_PROFILE=config/business.yaml
DATA_DIR=data
REPORTS_DIR=reports
SEARCH_DAYS=7
REPORT_LIMIT=20
ENABLE_SCHEDULER=false
REFRESH_CRON=0 6 * * *

# Optional notifications
ENABLE_SLACK=false
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_ID=
# Optional: workflow event Slack notifications for pursue/submitted/due-soon/follow-up-due
ENABLE_SLACK_WORKFLOW=false
SLACK_WORKFLOW_EVENTS=pursue,submitted,due-soon,follow-up-due

ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional AI assist. Default is deterministic/no-AI mode.
ENABLE_AI_ASSIST=false
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=20
